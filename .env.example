# Copy this file to `.env.local` and fill in what you need.
# Everything is optional — Open Schools runs with no configuration at all.

# Where the database file lives. Default: ./data/openschools.db
# DATABASE_PATH=/data/openschools.db

# The public web address of your Open Schools site (used in payment links,
# QR codes and emails). Default: worked out from the incoming request.
# APP_URL=https://openschools.yourschool.vic.edu.au

# Demo mode shows one-click demo logins on the sign-in page.
# Set to "false" once your school is using Open Schools for real.
# DEMO_MODE=false

# ---- Real payments (optional) ---------------------------------------------
# Without these, payments use a safe practice checkout where no money moves.
# Create a free Stripe account (https://stripe.com/au), then copy your keys.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
